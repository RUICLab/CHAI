# CHAI Environment Configuration — TEMPLATE
# Copy this file to `.env` and fill in your own keys.
# `.env` itself is gitignored — never commit real keys.

# LLM Configuration
# Options: "Anthropic", "OpenAI", "HuggingFace", or "Ollama".
# CHAI_API_NAME=Ollama
# LLM_MODEL=gpt-4o-2024-11-20
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_MODEL=claude-sonnet-4-20250514

# Anthropic API Key (if using Anthropic)
ANTHROPIC_API_KEY=your-anthropic-key-here

# OpenAI API Key (if using OpenAI)
OPENAI_API_KEY=your-openai-key-here

# HuggingFace API Token (if using HuggingFace / local Llama)
HF_TOKEN=your-huggingface-token-here

# Local Ollama (no cloud key required). For CHAI running in Docker, use
# host.docker.internal; for a native Linux run, use localhost.
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_TIMEOUT=600
# OLLAMA_MAX_TOKENS=2048
# OLLAMA_MAX_RETRIES=0
# OLLAMA_MIN_CONTEXT=24576

# Optimizer configuration. Conservative local seeds move one knob at a time
# from identity before multi-knob Bayesian search begins.
# CHAI_BO_AUTO_BUDGET=0
# CHAI_BO_LOCAL_IDENTITY_SEEDS=1
# CHAI_BO_LOCAL_SEED_FRACTION=0.10
# CHAI_BO_MAX_LOCAL_IDENTITY_SEEDS=4
